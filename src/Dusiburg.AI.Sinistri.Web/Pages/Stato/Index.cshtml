@page
@model Dusiburg.AI.Sinistri.Web.Pages.Stato.IndexModel
@{
    ViewData["Title"] = "Stato";
}

<h1 class="h3 mb-3">Stato del sistema</h1>
<p class="text-muted">SQL Server 2025, Ollama, modelli di chat e di embedding, dati della demo. Creazione del DB e calcolo degli embedding
    restano da riga di comando (<code>DbInit</code>, <code>embed</code>).</p>

@foreach (var errore in Model.Errori.Distinct())
{
    <div class="alert alert-danger">@errore</div>
}

@if (Model.Report is { } report)
{
    <h2 class="h5">Controlli</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>#</th><th>Controllo</th><th>Esito</th><th class="text-end">Durata</th><th>Dettaglio</th></tr></thead>
            <tbody>
                @foreach (var controllo in report.Controlli)
                {
                    <tr>
                        <td>@controllo.Numero</td>
                        <td>@controllo.Nome</td>
                        <td><span class="badge @SinistriPresentation.ProbeClass(controllo.Stato)">@SinistriPresentation.ProbeEtichetta(controllo.Stato)</span></td>
                        <td class="text-end">@controllo.Durata.TotalMilliseconds.ToString("0") ms</td>
                        <td class="small">@controllo.Dettaglio</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="row g-4">
    @if (Model.Dataset is { } dataset)
    {
        StatoSinistro[] stati = Enum.GetValues<StatoSinistro>();

        <div class="col-lg-7">
            <h2 class="h5">Dati della demo</h2>
            <p class="small">
                Contraenti @dataset.Conteggi.Contraenti · riparatori @dataset.Conteggi.Riparatori · polizze @dataset.Conteggi.Polizze ·
                clausole @dataset.Conteggi.Clausole · sinistri @dataset.Conteggi.Sinistri
            </p>
            <table class="table table-sm small">
                <thead><tr><th>Causa</th>@foreach (var stato in stati) { <th class="text-end">@stato</th> }<th class="text-end">Totale</th></tr></thead>
                <tbody>
                    @foreach (var causa in dataset.CausaStato.Select(r => r.Causa).Distinct())
                    {
                        <tr>
                            <td>@causa.Descrizione()</td>
                            @foreach (var stato in stati)
                            {
                                <td class="text-end">@dataset.CausaStato.Where(r => r.Causa == causa && r.Stato == stato).Sum(r => r.Sinistri)</td>
                            }
                            <td class="text-end">@dataset.CausaStato.Where(r => r.Causa == causa).Sum(r => r.Sinistri)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="small">
                Embedding salvati:
                @if (dataset.Embedding is { } info)
                {
                    <span>@info.Modello (@info.Provider.Descrizione(), @info.Dimensioni dimensioni) del @info.AggiornatoIl.ToString("dd/MM/yyyy HH:mm")</span>
                }
                else
                {
                    <span class="text-danger">non ancora calcolati: eseguire <code>embed</code>.</span>
                }
            </p>
        </div>
    }

    @if (Model.Configurazione is { } configurazione)
    {
        <div class="col-lg-5">
            <h2 class="h5">Parametri in uso</h2>
            <dl class="row small">
                <dt class="col-7">Modello di chat</dt><dd class="col-5">@configurazione.ChatModel</dd>
                <dt class="col-7">Modello di embedding</dt><dd class="col-5">@configurazione.EmbeddingModel (@configurazione.EmbeddingProvider, @configurazione.EmbeddingDimensions)</dd>
                <dt class="col-7">Clausole (top · distanza integrativa)</dt><dd class="col-5">@configurazione.Retrieval.TopClausole · @SinistriPresentation.Distanza(configurazione.Retrieval.DistanzaMaxClausolaIntegrativa)</dd>
                <dt class="col-7">Franchigia di base</dt><dd class="col-5">@(configurazione.Retrieval.ArticoloFranchigiaBase ?? "—")</dd>
                <dt class="col-7">Sinistri simili (top · nel prompt · anni)</dt><dd class="col-5">@configurazione.Retrieval.TopSinistri · @configurazione.Retrieval.SinistriNelPrompt · @configurazione.Retrieval.AnniStorico</dd>
                <dt class="col-7">Soglia fraud-scan</dt><dd class="col-5">@SinistriPresentation.Distanza(configurazione.SogliaDuplicatoCosine)</dd>
                <dt class="col-7">Soglia duplicati sulla denuncia</dt><dd class="col-5">@SinistriPresentation.Distanza(configurazione.SogliaDuplicatoDenuncia) · @configurazione.Retrieval.MesiControlloDuplicati mesi</dd>
            </dl>
            <p class="small text-muted">Si cambiano sull'AppHost (user-secrets o riga di comando), senza toccare i progetti.</p>
        </div>
    }
</div>
