@page
@model IndexModel
@{
    ViewData["Title"] = "Stato";
}

<h1 class="h3 mb-3">Assistente pre-istruttoria sinistri</h1>
<p class="text-muted">Stato dei componenti della demo: SQL Server 2025, Ollama, modelli di chat e di embedding.</p>

@if (Model.ApiError is { } error)
{
    <div class="alert alert-danger">API non raggiungibile: @error</div>
}
else if (Model.Report is { } report)
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>#</th><th>Controllo</th><th>Esito</th><th class="text-end">Durata</th><th>Dettaglio</th></tr>
        </thead>
        <tbody>
            @foreach (var controllo in report.Controlli)
            {
                <tr>
                    <td>@controllo.Numero</td>
                    <td>@controllo.Nome</td>
                    <td><span class="badge @IndexModel.BadgeClass(controllo.Stato)">@controllo.Stato</span></td>
                    <td class="text-end">@controllo.Durata.TotalMilliseconds.ToString("0") ms</td>
                    <td>@controllo.Dettaglio</td>
                </tr>
            }
        </tbody>
    </table>
}
