@model EsitoVista
@{
    EsitoPreIstruttoria esito = Model.Salvato.Esito;
    DatiPolizza polizza = esito.Polizza;
    Dictionary<string, ClausolaTrovata> clausole = esito.Clausole.DistinctBy(c => c.Articolo).ToDictionary(c => c.Articolo);
    TempiEsecuzione tempi = esito.Tempi;

    // Ogni articolo citato apre il testo integrale della clausola recuperata (fase-8.md §3.1): la citazione si verifica.
    void Articolo(string articolo)
    {
        if (clausole.TryGetValue(articolo, out ClausolaTrovata? clausola))
        {
            <button type="button" class="btn btn-link p-0 align-baseline fw-semibold" data-dialog="@SinistriPresentation.DialogClausola(clausola.Id)">@articolo — @clausola.Titolo</button>
        }
        else
        {
            <strong>@articolo</strong>
        }
    }
}

<section id="esito" class="mb-5">
    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">Scheda — polizza @polizza.Numero</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary btn-sm" asp-page="/Index" asp-page-handler="Scarica" asp-route-esito="@Model.Salvato.Id.ToString("N")">Scarica Markdown</a>
            @if (Model.LinkTraccia is { } traccia)
            {
                <a class="btn btn-outline-secondary btn-sm" href="@traccia" target="_blank" rel="noopener">Apri la traccia nel dashboard</a>
            }
        </div>
    </div>
    <p class="text-muted small">
        Generata il @esito.GenerataIl.ToString("dd/MM/yyyy HH:mm", Formati.Italiano) · modello @esito.Modello · tempo totale @SinistriPresentation.Secondi(tempi.Totale)
    </p>

    <div class="row g-3 mb-3">
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">Polizza e denuncia</div>
                <div class="card-body small">
                    <dl class="row mb-2">
                        <dt class="col-4">Prodotto</dt><dd class="col-8">@polizza.Prodotto.Descrizione()</dd>
                        <dt class="col-4">Contraente</dt><dd class="col-8">@polizza.Contraente (@polizza.Provincia)</dd>
                        <dt class="col-4">Validità</dt><dd class="col-8">@polizza.Decorrenza.ToString("dd/MM/yyyy") → @polizza.Scadenza.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-4">Massimale</dt><dd class="col-8">@Formati.Euro(polizza.Massimale)</dd>
                        <dt class="col-4">Franchigia</dt><dd class="col-8">@Formati.Euro(polizza.Franchigia)</dd>
                    </dl>
                    <blockquote class="border-start border-3 ps-2 mb-0 fst-italic">@esito.Richiesta.Denuncia</blockquote>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            @if (esito.Scheda is { } scheda)
            {
                <div class="card h-100">
                    <div class="card-header">Scheda di pre-istruttoria <span class="text-muted small">(generata dal modello, citazioni validate)</span></div>
                    <div class="card-body">
                        <h3 class="h6 text-success">Garanzie operanti</h3>
                        <ul class="scheda-lista">
                            @foreach (var garanzia in scheda.GaranzieOperanti)
                            {
                                <li class="border-success">@{ Articolo(garanzia.Articolo); }: @garanzia.Motivazione</li>
                            }
                            @if (scheda.GaranzieOperanti.Count == 0) { <li class="text-muted">Nessuna.</li> }
                        </ul>

                        <h3 class="h6 text-warning-emphasis">Esclusioni da verificare</h3>
                        <ul class="scheda-lista">
                            @foreach (var esclusione in scheda.EsclusioniDaVerificare)
                            {
                                <li class="border-warning">@{ Articolo(esclusione.Articolo); }: @esclusione.CosaVerificare</li>
                            }
                            @if (scheda.EsclusioniDaVerificare.Count == 0) { <li class="text-muted">Nessuna.</li> }
                        </ul>

                        <h3 class="h6 text-primary">Franchigia applicabile</h3>
                        <ul class="scheda-lista">
                            @if (scheda.FranchigiaApplicabile is { } franchigia)
                            {
                                <li class="border-primary">@{ Articolo(franchigia.Articolo); }: @franchigia.Descrizione</li>
                            }
                            else
                            {
                                <li class="text-muted">Non indicata.</li>
                            }
                        </ul>

                        <h3 class="h6">Punti da chiarire con il cliente</h3>
                        <ol class="small">
                            @foreach (var punto in scheda.PuntiDaChiarireConCliente)
                            {
                                <li>@punto</li>
                            }
                        </ol>

                        <h3 class="h6">Valutazione sintetica</h3>
                        <p class="mb-0">@scheda.ValutazioneSintetica</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card h-100 border-warning">
                    <div class="card-header">Scheda in testo libero <span class="text-muted small">(risposta non strutturata: citazioni non validate)</span></div>
                    <div class="card-body"><pre class="mb-0 testo-libero">@esito.TestoLibero</pre></div>
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <h3 class="h6">Possibili duplicati <span class="text-muted small">(controllo deterministico, fuori dal prompt)</span></h3>
            @if (esito.PossibiliDuplicati.Count == 0)
            {
                <p class="text-muted small">Nessuna segnalazione.</p>
            }
            @foreach (var duplicato in esito.PossibiliDuplicati)
            {
                <div class="alert @SinistriPresentation.MotivoClass(duplicato.Motivo) py-2 small">
                    ⚠️ <a asp-page="/Sinistri/Dettaglio" asp-route-numero="@duplicato.NumeroSinistro">@duplicato.NumeroSinistro</a>
                    (@duplicato.DataDenuncia.ToString("dd/MM/yyyy"), <strong>@duplicato.Motivo.Descrizione()</strong>) — distanza @SinistriPresentation.Distanza(duplicato.Distanza)
                    — contraente @duplicato.Contraente@(duplicato.Riparatore is { } r ? $" · riparatore {r}" : "")
                    <div class="text-muted">«@Formati.Tronca(duplicato.Descrizione, 160)»</div>
                </div>
            }
        </div>
        <div class="col-lg-6">
            <h3 class="h6">Avvisi della validazione</h3>
            @if (esito.Avvisi.Count == 0)
            {
                <p class="text-muted small">Nessun avviso.</p>
            }
            <ul class="small">
                @foreach (var avviso in esito.Avvisi)
                {
                    <li>⚠️ @avviso.Messaggio</li>
                }
            </ul>
        </div>
    </div>

    <h3 class="h6">Sinistri simili (@esito.Simili.Count più vicini)</h3>
    <div class="row g-3 mb-3">
        <div class="col-lg-9">
            <div class="table-responsive">
                <table class="table table-sm align-middle small">
                    <thead><tr><th>Numero</th><th>Data evento</th><th>Causa</th><th>Stato</th><th class="text-end">Liquidato</th><th class="text-end">Distanza</th></tr></thead>
                    <tbody>
                        @foreach (var simile in esito.Simili)
                        {
                            <tr>
                                <td><a asp-page="/Sinistri/Dettaglio" asp-route-numero="@simile.Numero">@simile.Numero</a></td>
                                <td>@simile.DataEvento.ToString("dd/MM/yyyy")</td>
                                <td>@simile.Causa.Descrizione()</td>
                                <td><span class="badge @SinistriPresentation.StatoSinistroClass(simile.Stato)">@simile.Stato</span></td>
                                <td class="text-end">@SinistriPresentation.Euro(simile.ImportoLiquidato)</td>
                                <td class="text-end">@SinistriPresentation.Distanza(simile.Distanza)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-3">
            <partial name="_Statistiche" model="esito.Statistiche" />
        </div>
    </div>

    <h3 class="h6">Clausole consultate</h3>
    <div class="table-responsive">
        <table class="table table-sm align-middle small">
            <thead><tr><th>#</th><th>Articolo</th><th>Tipo</th><th class="text-end">Distanza</th><th>Integrativa</th></tr></thead>
            <tbody>
                @foreach (var clausola in esito.Clausole)
                {
                    <tr>
                        <td>@clausola.Rank</td>
                        <td>@{ Articolo(clausola.Articolo); }</td>
                        <td><span class="badge @SinistriPresentation.TipoClausolaClass(clausola.Tipo)">@clausola.Tipo.Descrizione()</span></td>
                        <td class="text-end">@SinistriPresentation.Distanza(clausola.Distanza)</td>
                        <td>@(clausola.Integrativa ? "sì, limita la copertura" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h3 class="h6">Tempi per passo</h3>
    <p class="small text-muted">
        polizza @SinistriPresentation.Secondi(tempi.Polizza) · embedding @SinistriPresentation.Secondi(tempi.Embedding) ·
        clausole @SinistriPresentation.Secondi(tempi.Clausole) · storico @SinistriPresentation.Secondi(tempi.Storico) ·
        statistiche @SinistriPresentation.Secondi(tempi.Statistiche) · <strong>modello @SinistriPresentation.Secondi(tempi.Llm)</strong> ·
        antifrode @SinistriPresentation.Secondi(tempi.Antifrode)
    </p>

    @foreach (var clausola in clausole.Values)
    {
        <dialog id="@SinistriPresentation.DialogClausola(clausola.Id)" class="dialog-clausola">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h4 class="h6 mb-1">@clausola.Articolo — @clausola.Titolo</h4>
                <form method="dialog"><button class="btn-close" aria-label="Chiudi"></button></form>
            </div>
            <p class="mb-2"><span class="badge @SinistriPresentation.TipoClausolaClass(clausola.Tipo)">@clausola.Tipo.Descrizione()</span>
                <span class="text-muted small">distanza @SinistriPresentation.Distanza(clausola.Distanza)</span></p>
            <p class="mb-0">@clausola.Testo</p>
        </dialog>
    }
</section>
