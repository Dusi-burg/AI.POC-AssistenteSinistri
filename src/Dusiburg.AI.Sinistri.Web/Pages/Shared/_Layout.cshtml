<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Assistente sinistri</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dusiburg.AI.Sinistri.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Assistente sinistri</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Apri il menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Pre-istruttoria</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Clausole/Ricerca">Clausole</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Storico/Ricerca">Storico</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Antifrode/Index">Antifrode</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Dati demo</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Dati/Clausole">Catalogo clausole</a></li>
                                <li><a class="dropdown-item" asp-page="/Dati/Polizze">Polizze</a></li>
                                <li><a class="dropdown-item" asp-page="/Dati/Storico">Storico sinistri</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">@await Component.InvokeAsync("StatoSistema")</li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dusiburg.AI.Sinistri — POC RAG locale, dati sintetici e fittizi
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
